package unpack_gen

import (
    "github.com/indeedhat/unpack"

    {{- range .Mods }}
        unpack_t{{ .Alias }} "{{ .GenPath }}"
        t{{ .Alias }} "{{ .ModPath }}"
    {{- end }}
)

{{ if .Export }}
    var Register = unpack.NewRegister(handler)
{{ else }}
    func init() {
        unpack.RegisterHandler(handler)
    }
{{ end }}

func handler(r *unpack.Register, v any, data map[string]any) error {
    switch vv := v.(type) {
    {{- range $mod := .Mods }}
        {{- range $type := .Structs }}
        case *t{{ $mod.Alias }}.{{ $type }}:
            return unpack_t{{ $mod.Alias }}.Unpack{{ $type }}(r, vv, data)
        {{- end }}
    {{- end }}
    default:
        return unpack.ErrNotFound
    }
}
