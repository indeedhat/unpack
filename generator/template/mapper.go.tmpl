package unpack_{{ .Package }}

import (
    target "{{ .TargetPath }}"

    "github.com/indeedhat/unpack"
)

{{- range .Structs }}
func apply{{ .Name }}Mutations(r *unpack.Register, data map[string]any) error {
    {{- range $field := .Fields }}
        {{- range .Tag.Mutators }}
            {{- if $field.Dive }}
                {{- continue }}
            {{- end }}
            {{- if .Args }}
                if v, err := r.ApplyMutator("{{ .Name }}", data["{{ $field.Tag.Key }}"].({{ $field.Type }}), unpack.MutatorArgMap{
                            {{- range $k, $v := .Args }}
                    "{{ $k }}": {{ parse_arg $v }},
                            {{- end }}
                }); err != nil {
                        return err
                } else {
                    data["{{ $field.Tag.Key }}"] = v
                }
            {{- else }}
                if v, err := r.ApplyMutator("{{ .Name }}", data["{{ $field.Tag.Key }}"].({{ $field.Type }}), nil); err != nil {
                        return err
                } else {
                    data["{{ $field.Tag.Key }}"] = v
                }
            {{- end }}
        {{- end }}
    {{- end }}
    return nil
}

func Unpack{{ .Name }}(r *unpack.Register, t *target.{{ .Name }}, data map[string]any) error {
    if t == nil {
        t = &target.{{ .Name }}{}
    }
    if err := apply{{ .Name }}Mutations(r, data); err != nil {
        return err
    }
    {{- range $field := .Fields }}
        {{- range $field.Names }}
            {{- if $field.Dive }}
                if v, found := data["{{ $field.Tag.Key }}"]; found {
                    vv, ok := v.(map[string]any)
                    if ok {
                        if err := Unpack{{ $field.Type }}(r, {{ if not $field.Ptr }}&{{ end }}t.{{ .Name }}, vv); err != nil {
                            return err
                        }
                    }
                }
            {{- else }}
                if v, found := data["{{ $field.Tag.Key }}"]; found {
                    {{- if $field.Ptr }}
                        t.{{ .Name }} = new(v.(%s))
                    {{- else }}
                        t.{{ .Name }} = v.({{ $field.Type }})
                    {{- end }}
                }
            {{- end }}
        {{- end }}
    {{- end }}
    return nil
}
{{- end }}

